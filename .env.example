# ─────────────────────────────────────────────────────────────
# LoanFlow Processing LLC — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit .env. Nothing here is ever sent to the browser.
# ─────────────────────────────────────────────────────────────

# ── Server Configuration ─────────────────────────────────────
SERVER_PORT=3001
# Comma-separated list of allowed browser origins (the website itself).
CORS_ORIGIN=http://localhost:3000
# NODE_ENV=production enables HTTPS enforcement and strict origin checks.
NODE_ENV=development

# ── Flo intake (private) ─────────────────────────────────────
# Where the website backend delivers new loan submissions. This must be a
# PRIVATE address (Ashley's machine over a tunnel / VPN), never a public one.
# The intake server is scripts/flo/intake_server.py in the Flo repository.
FLO_INTAKE_URL=
# Shared secret; the same value goes in FLO_INTAKE_TOKEN on the intake server.
FLO_INTAKE_TOKEN=

# Where submissions are persisted (idempotency + pending-delivery queue).
# Defaults to server/data/submissions. Must be writable and persistent.
SUBMISSIONS_DIR=
# Public base URL of this API (used to build the document fetch URLs Flo calls back on).
PUBLIC_API_BASE_URL=https://lfprocessing.net

# ── Borrower documents (private storage) ─────────────────────
# Production: a PRIVATE Supabase Storage bucket. The service-role key never leaves the server.
# Leave SUPABASE_* blank to fall back to local disk (DOCUMENTS_DIR, dev / single host only).
DOCUMENT_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=loan-documents
DOCUMENTS_DIR=
DOCUMENTS_META_DIR=

# ── Electronic signatures (Documenso webhook receiver) ───────
# This website NEVER holds Documenso API credentials — only the shared secret
# used to verify an inbound Documenso webhook is really from Documenso
# (X-Documenso-Secret header, plain shared-secret compare, not HMAC). The
# actual Documenso API key lives only on the Flo/Hermes host (see FLO_ESIGN.md
# in the Flo repository), never here. A verified webhook is forwarded, with
# only the envelope id, to the same private Flo intake channel above.
DOCUMENSO_WEBHOOK_SECRET=

# ── Google Sheets (optional, legacy summary row) ─────────────
# Leave blank to skip. When set, one 12-column summary row per delivered
# submission is appended to "Form Responses 1" (no income/asset/credit data).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── Gemini AI (existing chat assistant) ──────────────────────
GEMINI_API_KEY=
