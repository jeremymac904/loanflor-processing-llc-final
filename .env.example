# ─────────────────────────────────────────────────────────────
# LoanFlow Processing LLC — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Google Service Account Credentials ───────────────────────
# These come from your Google Cloud service account JSON key.
# See SETUP.md for step-by-step instructions.

# The service account email (e.g. loanflow@my-project.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=

# The private key from the JSON key file.
# IMPORTANT: Paste the entire key including -----BEGIN PRIVATE KEY----- and
# -----END PRIVATE KEY-----. Keep the \n characters as-is.
GOOGLE_PRIVATE_KEY=

# The Google Sheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_SHEET_ID/edit
GOOGLE_SHEET_ID=

# ── Server Configuration ─────────────────────────────────────
SERVER_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ── Gemini AI (existing) ─────────────────────────────────────
GEMINI_API_KEY=
