# ─────────────────────────────────────────────────────────────
# LoanFlow Processing LLC — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit .env. Nothing here is ever sent to the browser.
# ─────────────────────────────────────────────────────────────

# ── Server Configuration ─────────────────────────────────────
SERVER_PORT=3001
# Comma-separated list of allowed browser origins (the website itself).
CORS_ORIGIN=http://localhost:3000
# NODE_ENV=production enables HTTPS enforcement and strict origin checks.
NODE_ENV=development

# ── Flo intake (private) ─────────────────────────────────────
# Where the website backend delivers new loan submissions. This must be a
# PRIVATE address (Ashley's machine over a tunnel / VPN), never a public one.
# The intake server is scripts/flo/intake_server.py in the Flo repository.
FLO_INTAKE_URL=
# Shared secret; the same value goes in FLO_INTAKE_TOKEN on the intake server.
FLO_INTAKE_TOKEN=

# Where submissions are persisted (idempotency + pending-delivery queue).
# Defaults to server/data/submissions. Must be writable and persistent.
SUBMISSIONS_DIR=

# ── Google Sheets (optional, legacy summary row) ─────────────
# Leave blank to skip. When set, one 12-column summary row per delivered
# submission is appended to "Form Responses 1" (no income/asset/credit data).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── Gemini AI (existing chat assistant) ──────────────────────
GEMINI_API_KEY=
