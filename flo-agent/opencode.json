{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".flo/docs/PROJECT_CONTEXT.md"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/auth.json": "deny",
      "**/.credentials.json": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "bash": "deny",
    "task": "deny",
    "external_directory": "deny"
  }
}
