# Copy to .env in this same directory (deploy/documenso/.env) on the Linux Docker host. Never commit .env.
# Generate real values with the commands shown — do not reuse the placeholders below.

# --- Postgres ---
POSTGRES_USER=documenso
POSTGRES_PASSWORD=                     # openssl rand -base64 24
POSTGRES_DB=documenso

# --- App secrets ---
NEXTAUTH_SECRET=                       # openssl rand -base64 32
NEXT_PRIVATE_ENCRYPTION_KEY=           # openssl rand -base64 32   (min 32 chars)
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY= # openssl rand -base64 32   (min 32 chars, must differ from the key above)

# --- Public URL (this is the proposed sign.lfprocessing.net once DNS points at this host) ---
NEXT_PUBLIC_WEBAPP_URL=https://sign.lfprocessing.net

# --- PDF signing certificate ---
# cert.p12 must sit next to docker-compose.yml on the host (see FLO_ESIGN.md for how it's generated for
# this test — a self-signed dev cert — and the production-trust decision that still needs an owner call).
SIGNING_CERT_PASSPHRASE=               # openssl rand -base64 24

# --- Test-only mail sender identity (maildev captures everything locally; nothing leaves the host) ---
SMTP_FROM_ADDRESS=esign-test@lfprocessing.net
SMTP_FROM_NAME=LoanFlow Processing (test)

# --- Port Documenso listens on inside the container / is published on the host ---
PORT=3000
